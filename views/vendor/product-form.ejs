<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>
<div class="dash-shell">
  <%- include('../partials/vendor-sidebar') %>
  <main class="dash-main">
    <h3 class="mb-4"><%= product ? 'Edit Product' : 'Add New Product' %></h3>
    <form method="POST" action="<%= product ? `/vendor/products/${product.id}/edit` : '/vendor/products/new' %>" enctype="multipart/form-data">
      <div class="row g-4">
        <div class="col-lg-8">
          <div class="pd-card p-4 mb-4">
            <h6 class="mb-3">Basic Information</h6>
            <div class="row g-3">
              <div class="col-12"><label class="form-label">Product Name</label><input type="text" name="name" class="form-control" value="<%= product ? product.name : '' %>" required></div>
              <div class="col-md-6">
                <label class="form-label">Category</label>
                <select name="category_id" class="form-select">
                  <option value="">Select category</option>
                  <% categories.forEach(c => { %>
                    <option value="<%= c.id %>" <%= product && product.category_id === c.id ? 'selected' : '' %>><%= c.name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-6"><label class="form-label">Base Price (Rs)</label><input type="number" step="0.01" name="base_price" class="form-control" value="<%= product ? product.base_price : '' %>" required></div>
              <div class="col-12"><label class="form-label">Description</label><textarea name="description" class="form-control" rows="4"><%= product ? product.description : '' %></textarea></div>
              <div class="col-md-6"><label class="form-label">Stock Quantity</label><input type="number" name="stock" class="form-control" value="<%= product ? product.stock : 100 %>"></div>
            </div>
          </div>

          <div class="pd-card p-4 mb-4">
            <h6 class="mb-3">Product Images</h6>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label">Front Image <%= !product ? '(required)' : '' %></label>
                <input type="file" name="front_image" accept="image/*" class="form-control" <%= !product ? 'required' : '' %>>
                <% if (product && product.front_image) { %><img src="<%= product.front_image %>" class="mt-2 rounded-3" style="width:100px;height:100px;object-fit:cover;"><% } %>
              </div>
              <div class="col-md-6">
                <label class="form-label">Back Image (optional)</label>
                <input type="file" name="back_image" accept="image/*" class="form-control">
                <% if (product && product.back_image) { %><img src="<%= product.back_image %>" class="mt-2 rounded-3" style="width:100px;height:100px;object-fit:cover;"><% } %>
              </div>
            </div>
          </div>

          <%- include('../partials/product-variant-fields') %>

          <div class="pd-card p-4">
            <h6 class="mb-3">Available Materials <span class="text-muted small">(used for price calculation)</span></h6>
            <p class="text-muted small">Only select the exact materials (not group headings) that apply to this product. If you select materials from more than one group, customers will see a two-step "choose type, then choose material" selector.</p>
            <% const leafMaterials = materials.filter(m => m.parent_id); %>
            <% const groupedByParent = {}; %>
            <% leafMaterials.forEach(m => { const key = m.parent_id; if (!groupedByParent[key]) groupedByParent[key] = []; groupedByParent[key].push(m); }) %>
            <% Object.keys(groupedByParent).forEach(parentId => { %>
              <% const parent = materials.find(g => g.id === Number(parentId)); %>
              <div class="mb-3">
                <div class="small fw-semibold text-muted mb-1"><i class="bi bi-diagram-3 me-1"></i><%= parent ? parent.name : 'Other' %></div>
                <div class="row g-2">
                  <% groupedByParent[parentId].forEach(m => { %>
                    <div class="col-md-4 col-6">
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="materials" value="<%= m.id %>" id="mat<%= m.id %>" <%= selectedMaterials.includes(m.id) ? 'checked' : '' %>>
                        <label class="form-check-label small" for="mat<%= m.id %>"><%= m.name %> <span class="text-muted">(+Rs<%= m.price_per_unit %>/sq.in)</span></label>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% }) %>
            <% const standaloneMaterials = materials.filter(m => !m.parent_id && !materials.some(c => c.parent_id === m.id)); %>
            <% if (standaloneMaterials.length) { %>
              <div class="mb-2">
                <div class="small fw-semibold text-muted mb-1"><i class="bi bi-square me-1"></i>Standalone Materials</div>
                <div class="row g-2">
                  <% standaloneMaterials.forEach(m => { %>
                    <div class="col-md-4 col-6">
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="materials" value="<%= m.id %>" id="mat<%= m.id %>" <%= selectedMaterials.includes(m.id) ? 'checked' : '' %>>
                        <label class="form-check-label small" for="mat<%= m.id %>"><%= m.name %> <span class="text-muted">(+Rs<%= m.price_per_unit %>/sq.in)</span></label>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </div>
            <% } %>
            <% if (materials.length === 0) { %><p class="text-muted small">No materials configured. Ask admin to add materials first.</p><% } %>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="pd-card p-4">
            <h6 class="mb-3">Customization Options</h6>
            <div class="form-check form-switch mb-3">
              <input class="form-check-input" type="checkbox" name="supports_text" id="supText" <%= !product || product.supports_text ? 'checked' : '' %>>
              <label class="form-check-label small" for="supText">Allow text customization</label>
            </div>
            <div class="form-check form-switch mb-3">
              <input class="form-check-input" type="checkbox" name="supports_image" id="supImage" <%= !product || product.supports_image ? 'checked' : '' %>>
              <label class="form-check-label small" for="supImage">Allow image upload</label>
            </div>
            <div class="form-check form-switch mb-3">
              <input class="form-check-input" type="checkbox" name="supports_back_print" id="supBack" <%= !product || product.supports_back_print ? 'checked' : '' %>>
              <label class="form-check-label small" for="supBack">Allow back-side printing</label>
            </div>
            <hr>
            <div class="alert alert-info small mb-0">
              <i class="bi bi-info-circle me-1"></i> Your product will be reviewed by an admin before it appears in the store.
            </div>
          </div>
          <button type="submit" class="btn btn-podify-primary w-100 py-2 rounded-pill-lg mt-4">
            <%= product ? 'Update Product' : 'Submit for Approval' %>
          </button>
        </div>
      </div>
    </form>
  </main>
</div>
<%- include('../partials/scripts') %>
</body>
</html>
