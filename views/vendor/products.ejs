<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>
<div class="dash-shell">
  <%- include('../partials/vendor-sidebar') %>
  <main class="dash-main">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h3 class="mb-0">My Products</h3>
      <a href="/vendor/products/new" class="btn btn-podify-primary rounded-pill px-4"><i class="bi bi-plus-lg me-1"></i>Add Product</a>
    </div>
    <% if (products.length === 0) { %>
      <div class="empty-state"><i class="bi bi-box-seam"></i><h5>No products yet</h5><p class="text-muted">Add your first product to start selling on Podify.</p><a href="/vendor/products/new" class="btn btn-podify-primary rounded-pill px-4 mt-2">Add Product</a></div>
    <% } else { %>
      <div class="row g-4">
        <% products.forEach(p => { %>
          <div class="col-lg-4 col-md-6">
            <div class="pd-card product-card">
              <div class="img-wrap"><img src="<%= p.front_image %>" alt=""></div>
              <div class="body">
                <div class="d-flex justify-content-between align-items-start mb-1">
                  <div class="cat-badge"><%= p.category_name || '—' %></div>
                  <span class="status-pill status-<%= p.status %>"><%= p.status %></span>
                </div>
                <h6 class="mb-1"><%= p.name %></h6>
                <% if (p.status === 'rejected' && p.rejection_reason) { %>
                  <p class="text-danger small mb-2"><i class="bi bi-exclamation-circle"></i> <%= p.rejection_reason %></p>
                <% } %>
                <div class="d-flex justify-content-between align-items-center mt-2">
                  <span class="price-tag">Rs <%= p.base_price.toFixed(0) %></span>
                  <span class="text-muted small">Stock: <%= p.stock %></span>
                </div>
                <div class="d-flex gap-2 mt-3">
                  <a href="/vendor/products/<%= p.id %>/edit" class="btn btn-sm btn-podify-outline rounded-pill flex-fill">Edit</a>
                  <form method="POST" action="/vendor/products/<%= p.id %>/delete" data-confirm="Delete this product permanently?" class="flex-fill">
                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill w-100">Delete</button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </main>
</div>
<%- include('../partials/scripts') %>
</body>
</html>
