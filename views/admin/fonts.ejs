<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>
<div class="dash-shell">
  <%- include('../partials/admin-sidebar') %>
  <main class="dash-main">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <div><h3 class="mb-0">Font Management</h3><p class="text-muted mb-0">Fonts available in the product customizer, including calligraphy styles</p></div>
      <button class="btn btn-podify-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addModal"><i class="bi bi-plus-lg me-1"></i>Add Font</button>
    </div>
    <div class="row g-3">
      <% fonts.forEach(f => { %>
        <div class="col-md-4 col-6">
          <div class="pd-card p-4 text-center">
            <div style="font-family: <%= f.css_family %>; font-size: 1.6rem;">Aa Bb Cc</div>
            <div class="fw-semibold small mt-2"><%= f.name %></div>
            <% if (f.is_calligraphy) { %><span class="status-pill status-approved mt-1">Calligraphy</span><% } %>
            <form method="POST" action="/admin/fonts/<%= f.id %>/delete" class="mt-2" data-confirm="Delete this font?"><button class="btn btn-sm btn-outline-danger rounded-pill"><i class="bi bi-trash"></i></button></form>
          </div>
        </div>
      <% }) %>
      <% if (fonts.length === 0) { %><div class="col-12 text-muted text-center py-4">No fonts added yet.</div><% } %>
    </div>
  </main>
</div>

<div class="modal fade" id="addModal" tabindex="-1">
  <div class="modal-dialog"><div class="modal-content">
    <form method="POST" action="/admin/fonts/new">
      <div class="modal-header"><h5 class="modal-title">Add Font</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="mb-3"><label class="form-label">Display Name</label><input type="text" name="name" class="form-control" placeholder="e.g. Pacifico" required></div>
        <div class="mb-3"><label class="form-label">CSS Font Family</label><input type="text" name="css_family" class="form-control" placeholder="e.g. 'Pacifico', cursive" required></div>
        <div class="form-check"><input class="form-check-input" type="checkbox" name="is_calligraphy" id="isCalligraphy"><label class="form-check-label" for="isCalligraphy">This is a calligraphy-style font</label></div>
      </div>
      <div class="modal-footer"><button class="btn btn-podify-primary rounded-pill px-4">Add Font</button></div>
    </form>
  </div></div>
</div>

<%- include('../partials/scripts') %>
</body>
</html>
