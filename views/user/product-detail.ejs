<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <script src="/vendor/fabric/fabric.min.js"></script>
</head>
<body>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<div class="container section-pad">
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
      <li class="breadcrumb-item"><a href="/">Home</a></li>
      <li class="breadcrumb-item"><a href="/products">Products</a></li>
      <li class="breadcrumb-item active"><%= product.name %></li>
    </ol>
  </nav>

  <div id="customizerRoot" data-product='<%- JSON.stringify({ id: product.id, front_image: product.front_image, back_image: product.back_image, name: product.name }) %>' data-printable='<%- JSON.stringify(printableArea) %>' data-variants='<%- JSON.stringify(variants) %>'>
    <div class="row g-4">
      <!-- LEFT: Canvas Stage -->
      <div class="col-lg-6">
        <div class="customizer-stage p-3">
          <canvas id="previewCanvas" width="460" height="460"></canvas>
        </div>

        <div class="d-flex gap-2 mt-3 justify-content-center">
          <button class="btn btn-podify-outline rounded-pill px-4 side-toggle-btn active" data-side="front"><i class="bi bi-square me-1"></i> Front</button>
          <% if (product.supports_back_print) { %>
            <button class="btn btn-podify-outline rounded-pill px-4 side-toggle-btn" data-side="back"><i class="bi bi-square-fill me-1"></i> Back</button>
          <% } %>
        </div>

        <div class="pd-card p-3 mt-3">
          <h6 class="mb-3"><i class="bi bi-magic me-2"></i>Design Tools</h6>
          <ul class="nav nav-pills customizer-tabs mb-3 gap-2" role="tablist">
            <% if (product.supports_text) { %>
            <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tabText">Add Text</button></li>
            <% } %>
            <% if (product.supports_image) { %>
            <li class="nav-item"><button class="nav-link <%= !product.supports_text ? 'active' : '' %>" data-bs-toggle="pill" data-bs-target="#tabImage">Upload Image</button></li>
            <% } %>
          </ul>
          <div class="tab-content">
            <% if (product.supports_text) { %>
            <div class="tab-pane fade show active" id="tabText">
              <div class="mb-3">
                <label class="form-label">Your Text</label>
                <input type="text" id="customText" class="form-control" placeholder="Type something beautiful...">
              </div>
              <div class="row g-2 mb-3">
                <div class="col-8">
                  <label class="form-label">Font</label>
                  <select id="fontSelect" class="form-select">
                    <% fonts.forEach(f => { %>
                      <option value="<%= f.css_family %>" <%= f.is_calligraphy ? 'data-calligraphy="1"' : '' %>><%= f.name %><%= f.is_calligraphy ? ' (Calligraphy)' : '' %></option>
                    <% }) %>
                    <% if (fonts.length === 0) { %>
                      <option value="Poppins">Poppins</option>
                      <option value="'Dancing Script', cursive">Dancing Script (Calligraphy)</option>
                      <option value="'Great Vibes', cursive">Great Vibes (Calligraphy)</option>
                    <% } %>
                  </select>
                </div>
                <div class="col-4">
                  <label class="form-label">Color</label>
                  <input type="color" id="textColorPicker" class="form-control form-control-color w-100" value="#14142B">
                </div>
              </div>
              <button type="button" id="addTextBtn" class="btn btn-podify-primary rounded-pill px-4"><i class="bi bi-plus-lg me-1"></i> Add Text</button>
            </div>
            <% } %>
            <% if (product.supports_image) { %>
            <div class="tab-pane fade <%= !product.supports_text ? 'show active' : '' %>" id="tabImage">
              <p class="text-muted small">Upload your own photo, logo, or artwork (PNG, JPG, SVG — max 8MB)</p>
              <input type="file" id="customImageInput" accept="image/*" class="d-none">
              <button type="button" id="uploadImageBtn" class="btn btn-podify-outline rounded-pill px-4">
                <i class="bi bi-upload me-1"></i> Upload Image
              </button>
            </div>
            <% } %>
          </div>
          <hr>
          <div class="d-flex gap-2">
            <button type="button" id="deleteSelectedBtn" class="btn btn-outline-danger btn-sm rounded-pill px-3"><i class="bi bi-trash me-1"></i>Delete Selected</button>
            <button type="button" id="clearCanvasBtn" class="btn btn-outline-secondary btn-sm rounded-pill px-3"><i class="bi bi-arrow-counterclockwise me-1"></i>Clear All</button>
          </div>
          <p class="text-muted small mt-2 mb-0"><i class="bi bi-lightbulb me-1"></i>Tip: click any text on the canvas to select it, then change its font or color to restyle that exact text.</p>
        </div>
      </div>

      <!-- RIGHT: Options & Price -->
      <div class="col-lg-6">
        <div class="sticky-summary">
          <div class="cat-badge"><%= product.category_name || 'Podify' %></div>
          <h2 class="mb-2"><%= product.name %></h2>
          <div class="d-flex align-items-center gap-2 mb-3">
            <div class="rating-stars">
              <% for (let i=1;i<=5;i++) { %><i class="bi <%= i <= Math.round(product.rating_avg) ? 'bi-star-fill' : 'bi-star' %>"></i><% } %>
            </div>
            <span class="text-muted small">(<%= product.rating_count %> reviews)</span>
            <span class="divider-dot"></span>
            <span class="text-muted small">by <%= product.vendor_name %></span>
          </div>
          <p class="text-muted"><%= product.description %></p>

          <!-- product's own color, separate from print/text color -->
          <% if (variants.length > 1) { %>
          <h6 class="mt-4 mb-2">Product Color <span class="text-muted small fw-normal">(<span id="selectedColorName"><%= variants[0].color_name %></span>)</span></h6>
          <div class="d-flex gap-2 flex-wrap" id="colorSwatchRow">
            <% variants.forEach((v, i) => { %>
              <div class="color-variant-swatch <%= i === 0 ? 'active' : '' %>" data-variant-id="<%= v.id %>" data-color-name="<%= v.color_name %>" style="background:<%= v.color_hex %>;" title="<%= v.color_name %>"></div>
            <% }) %>
          </div>
          <% } %>

          <h6 class="mt-4 mb-2">1. Choose Material</h6>
          <% const groupKeys = Object.keys(materialGroups); %>
          <% if (groupKeys.length > 1) { %>
            <p class="text-muted small mb-2">Step 1 — What is the surface type?</p>
            <div class="d-flex gap-2 flex-wrap mb-3">
              <% groupKeys.forEach(g => { %>
                <div class="group-swatch" data-group="<%= g %>"><%= g %></div>
              <% }) %>
            </div>
            <div id="materialLeafStep" style="display:none;">
              <p class="text-muted small mb-2">Step 2 — Choose the exact material:</p>
              <div class="row g-2" id="materialLeafOptions"></div>
            </div>
            <script type="application/json" id="materialGroupsData"><%- JSON.stringify(materialGroups) %></script>
          <% } else { %>
            <div class="row g-2">
              <% materials.forEach(m => { %>
                <div class="col-4 col-md-3">
                  <div class="material-swatch" data-material-id="<%= m.id %>"><%= m.name %></div>
                </div>
              <% }) %>
            </div>
          <% } %>
          <% if (materials.length === 0) { %><p class="text-muted small">No materials configured for this product yet.</p><% } %>

          <!-- Print Size Selector -->
          <h6 class="mt-4 mb-2">2. Choose Print Size</h6>
          <div class="d-flex gap-2 flex-wrap">
            <% sizes.forEach(s => { %>
              <div class="size-swatch" data-size-id="<%= s.id %>"><%= s.label %> <span class="text-muted">(<%= s.width_in %>×<%= s.height_in %>in)</span></div>
            <% }) %>
          </div>

          <!-- Back print + qty -->
          <div class="row mt-4 g-3 align-items-center">
            <% if (product.supports_back_print) { %>
            <div class="col-md-6">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="backPrintToggle">
                <label class="form-check-label small" for="backPrintToggle">Also print on back side</label>
              </div>
            </div>
            <% } %>
            <div class="col-md-6">
              <label class="form-label small mb-1">Quantity</label>
              <input type="number" id="quantityInput" class="form-control form-control-sm" value="1" min="1" style="width:100px">
            </div>
          </div>

          <!-- Price Box -->
          <div class="price-box mt-4">
            <div class="row-line"><span>Base Price</span><span id="priceBase">Rs 0.00</span></div>
            <div class="row-line"><span>Print Size Cost</span><span id="priceSize">Rs 0.00</span></div>
            <div class="row-line"><span>Material Cost</span><span id="priceMaterial">Rs 0.00</span></div>
            <div class="row-line" id="backPrintRow" style="display:none;"><span>Back Print</span><span id="priceBack">Rs 0.00</span></div>
            <div class="row-line"><span>Unit Price</span><span id="priceUnit">Rs 0.00</span></div>
            <div class="total-line"><span>Total</span><span id="priceTotal">Rs 0.00</span></div>
          </div>

          <button type="button" id="addToCartBtn" class="btn btn-podify-primary w-100 py-3 rounded-pill-lg mt-3 fs-6">
            <i class="bi bi-bag-plus me-2"></i>Add to Cart
          </button>
          <div class="d-flex justify-content-around text-center mt-4 text-muted small">
            <div><i class="bi bi-truck d-block fs-5 mb-1"></i>Fast Delivery</div>
            <div><i class="bi bi-shield-check d-block fs-5 mb-1"></i>Secure Checkout</div>
            <div><i class="bi bi-arrow-repeat d-block fs-5 mb-1"></i>Easy Returns</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- REVIEWS -->
  <div class="row mt-5">
    <div class="col-lg-8">
      <h4 class="mb-4">Customer Reviews (<%= reviews.length %>)</h4>
      <% reviews.forEach(r => { %>
        <div class="pd-card p-3 mb-3">
          <div class="d-flex justify-content-between">
            <div class="d-flex align-items-center gap-2">
              <img src="<%= r.avatar || '/images/default-avatar.svg' %>" class="avatar-sm">
              <div>
                <div class="fw-semibold small"><%= r.user_name %></div>
                <div class="rating-stars small"><% for (let i=1;i<=5;i++) { %><i class="bi <%= i <= r.rating ? 'bi-star-fill' : 'bi-star' %>"></i><% } %></div>
              </div>
            </div>
            <small class="text-muted"><%= new Date(r.created_at).toLocaleDateString() %></small>
          </div>
          <p class="mt-2 mb-0 small text-muted"><%= r.comment %></p>
        </div>
      <% }) %>
      <% if (reviews.length === 0) { %>
        <p class="text-muted">No reviews yet. Be the first to review this product after your order arrives!</p>
      <% } %>
    </div>
  </div>

  <!-- RELATED -->
  <% if (related.length > 0) { %>
  <div class="mt-5">
    <h4 class="mb-4">You Might Also Like</h4>
    <div class="row g-4">
      <% related.forEach(p => { %>
        <div class="col-lg-3 col-md-6"><%- include('../partials/product-card', { p }) %></div>
      <% }) %>
    </div>
  </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
<script src="/js/customizer.js"></script>
</body>
</html>
