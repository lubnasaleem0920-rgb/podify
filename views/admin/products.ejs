<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>
<div class="dash-shell">
  <%- include('../partials/admin-sidebar') %>
  <main class="dash-main">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h3 class="mb-0">Product Approval</h3>
      <a href="/admin/products/new" class="btn btn-podify-primary rounded-pill px-4"><i class="bi bi-plus-lg me-1"></i>Add Product Directly</a>
    </div>
    <ul class="nav nav-pills customizer-tabs mb-4 gap-2">
      <li><a class="nav-link <%= statusFilter==='pending'?'active':'' %>" href="/admin/products?status=pending">Pending</a></li>
      <li><a class="nav-link <%= statusFilter==='approved'?'active':'' %>" href="/admin/products?status=approved">Approved</a></li>
      <li><a class="nav-link <%= statusFilter==='rejected'?'active':'' %>" href="/admin/products?status=rejected">Rejected</a></li>
    </ul>

    <div class="row g-4">
      <% products.forEach(p => { %>
        <div class="col-lg-4 col-md-6">
          <div class="pd-card product-card">
            <div class="img-wrap"><img src="<%= p.front_image %>" alt=""></div>
            <div class="body">
              <div class="cat-badge"><%= p.category_name || '—' %></div>
              <h6 class="mb-1"><%= p.name %></h6>
              <div class="text-muted small mb-2">by <%= p.vendor_name %> · Rs <%= p.base_price.toFixed(0) %></div>
              <p class="small text-muted text-truncate"><%= p.description %></p>
              <% if (statusFilter === 'pending') { %>
                <div class="d-flex gap-2 mt-2">
                  <form method="POST" action="/admin/products/<%= p.id %>/approve" class="flex-fill"><button class="btn btn-sm btn-podify-primary rounded-pill w-100">Approve</button></form>
                  <button class="btn btn-sm btn-outline-danger rounded-pill flex-fill" data-bs-toggle="modal" data-bs-target="#rejectModal<%= p.id %>">Reject</button>
                </div>
              <% } else { %>
                <span class="status-pill status-<%= p.status %>"><%= p.status %></span>
                <div class="d-flex gap-2 mt-2">
                  <a href="/admin/products/<%= p.id %>/edit" class="btn btn-sm btn-podify-outline rounded-pill flex-fill">Edit</a>
                  <form method="POST" action="/admin/products/<%= p.id %>/delete" class="flex-fill" data-confirm="Delete this product?"><button class="btn btn-sm btn-outline-danger rounded-pill w-100"><i class="bi bi-trash"></i></button></form>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
      <% if (products.length === 0) { %><div class="col-12 empty-state"><i class="bi bi-box-seam"></i><h5>No products here</h5></div><% } %>
    </div>
  </main>
</div>

<!-- Reject modals live outside the card grid entirely. The cards above use a hover
     transform and overflow:hidden, and a CSS transform on an ancestor traps any
     position:fixed element (like a Bootstrap modal) inside it instead of the full
     screen — that trapped, clipped rendering is what showed up as "blinking". -->
<% if (statusFilter === 'pending') { %>
  <% products.forEach(p => { %>
    <div class="modal fade" id="rejectModal<%= p.id %>" tabindex="-1">
      <div class="modal-dialog"><div class="modal-content">
        <form method="POST" action="/admin/products/<%= p.id %>/reject">
          <div class="modal-header"><h5 class="modal-title">Reject Product</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
          <div class="modal-body"><label class="form-label">Reason</label><textarea name="reason" class="form-control" required></textarea></div>
          <div class="modal-footer"><button class="btn btn-outline-danger rounded-pill px-4">Confirm Reject</button></div>
        </form>
      </div></div>
    </div>
  <% }) %>
<% } %>
<%- include('../partials/scripts') %>
</body>
</html>
