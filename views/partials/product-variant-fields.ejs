          <div class="pd-card p-4 mb-4">
            <h6 class="mb-1">Product Color <span class="text-muted small fw-normal">(this is the product's own color — separate from the print/text color the customer picks later)</span></h6>
            <div class="row g-3 mt-1">
              <div class="col-md-4">
                <label class="form-label">Color Name</label>
                <input type="text" name="primary_color_name" class="form-control" placeholder="e.g. White" value="<%= (existingVariants[0] && existingVariants[0].color_name) || 'Default' %>">
              </div>
              <div class="col-md-2">
                <label class="form-label">Swatch</label>
                <input type="color" name="primary_color_hex" class="form-control form-control-color w-100" value="<%= (existingVariants[0] && existingVariants[0].color_hex) || '#CCCCCC' %>">
              </div>
            </div>
            <p class="text-muted small mt-2 mb-0">This uses the Front/Back images from "Product Images" above as its picture.</p>
          </div>

          <div class="pd-card p-4 mb-4">
            <h6 class="mb-1">Additional Colors <span class="text-muted small fw-normal">(optional — lets customers switch the product's color on the product page)</span></h6>
            <p class="text-muted small">Fill in a name and upload a front image to add a color. Leave blank to skip.</p>

            <% for (let i = 1; i <= 3; i++) { %>
              <hr class="my-3">
              <div class="row g-3 align-items-end">
                <div class="col-md-3">
                  <label class="form-label small">Color <%= i + 1 %> Name</label>
                  <input type="text" name="variant<%= i %>_name" class="form-control form-control-sm" placeholder="e.g. Black">
                </div>
                <div class="col-md-2">
                  <label class="form-label small">Swatch</label>
                  <input type="color" name="variant<%= i %>_hex" class="form-control form-control-sm form-control-color w-100" value="#333333">
                </div>
                <div class="col-md-3">
                  <label class="form-label small">Front Image</label>
                  <input type="file" name="variant<%= i %>_front" accept="image/*" class="form-control form-control-sm">
                </div>
                <div class="col-md-3">
                  <label class="form-label small">Back Image (optional)</label>
                  <input type="file" name="variant<%= i %>_back" accept="image/*" class="form-control form-control-sm">
                </div>
              </div>
            <% } %>

            <% if (existingVariants && existingVariants.length > 1) { %>
              <hr class="my-3">
              <p class="small fw-semibold mb-2">Already-added colors for this product:</p>
              <div class="d-flex gap-2 flex-wrap">
                <% existingVariants.forEach(v => { %>
                  <div class="d-flex align-items-center gap-2 border rounded-pill px-3 py-1" style="border-color:var(--pd-border) !important;">
                    <span class="d-inline-block rounded-circle" style="width:14px;height:14px;background:<%= v.color_hex %>;"></span>
                    <span class="small"><%= v.color_name %></span>
                  </div>
                <% }) %>
              </div>
              <p class="text-muted small mt-2 mb-0">To add more, fill in the empty slots above — existing colors won't be affected.</p>
            <% } %>
          </div>
