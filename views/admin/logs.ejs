<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>
<div class="dash-shell">
  <%- include('../partials/admin-sidebar') %>
  <main class="dash-main">
    <h3 class="mb-4">System Activity Logs</h3>
    <div class="pd-card">
      <div class="table-responsive">
        <table class="table pd-table mb-0">
          <thead><tr><th>User</th><th>Action</th><th>Details</th><th>IP</th><th>Time</th></tr></thead>
          <tbody>
            <% logs.forEach(l => { %>
              <tr>
                <td class="small fw-semibold"><%= l.user_name || 'System' %></td>
                <td><span class="status-pill status-confirmed"><%= l.action %></span></td>
                <td class="small text-muted"><%= l.details %></td>
                <td class="small text-muted"><%= l.ip_address %></td>
                <td class="small text-muted"><%= new Date(l.created_at).toLocaleString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% if (logs.length === 0) { %><p class="text-muted text-center py-4 mb-0">No activity yet.</p><% } %>
    </div>
  </main>
</div>
<%- include('../partials/scripts') %>
</body>
</html>
