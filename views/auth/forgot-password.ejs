<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/flash') %>
<div class="auth-wrapper">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-5">
        <div class="pd-form-card">
          <a href="/" class="brand-text d-inline-flex align-items-center mb-4" style="color:var(--pd-text);"><i class="bi bi-stars me-1 text-gradient"></i>Podify</a>
          <h3 class="mb-1">Forgot Password?</h3>
          <p class="text-muted mb-4">Enter your email and we'll help you reset it.</p>
          <form method="POST" action="/auth/forgot-password">
            <div class="mb-3">
              <label class="form-label">Email Address</label>
              <input type="email" name="email" class="form-control" placeholder="you@example.com" required>
            </div>
            <button type="submit" class="btn btn-podify-primary w-100 py-2 rounded-pill-lg">Send Reset Link</button>
          </form>

          <% if (typeof resetLink !== 'undefined' && resetLink) { %>
            <div class="alert alert-success mt-4">
              <i class="bi bi-envelope-check me-2"></i>
              Since Podify doesn't have live email delivery configured in this demo, here's your reset link:
              <a href="<%= resetLink %>" class="fw-semibold d-block mt-2"><%= resetLink %></a>
            </div>
          <% } %>

          <p class="text-center text-muted mt-4 mb-0"><a href="/auth/login" class="fw-semibold"><i class="bi bi-arrow-left me-1"></i>Back to Login</a></p>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/scripts') %>
</body>
</html>
