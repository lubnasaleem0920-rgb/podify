<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/flash') %>
<div class="auth-wrapper">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-9">
        <div class="row g-0 shadow-lg rounded-4 overflow-hidden">
          <div class="col-lg-5 auth-side d-none d-lg-flex">
            <a href="/" class="brand-text mb-4" style="font-size:1.6rem;"><i class="bi bi-stars me-1"></i>Podify</a>
            <h3 class="text-white mb-3"><%= role === 'vendor' ? 'Sell on Podify' : 'Join Podify Today' %></h3>
            <p class="text-white-50"><%= role === 'vendor' ? 'List your printable products, reach thousands of customers, and manage orders with ease.' : 'Create an account to design and order custom-printed products in minutes.' %></p>
            <div class="mt-4 d-flex gap-2">
              <a href="/auth/register?role=customer" class="btn btn-sm rounded-pill px-3 <%= role==='customer' ? 'btn-light' : 'btn-outline-light' %>">I'm a Customer</a>
              <a href="/auth/register?role=vendor" class="btn btn-sm rounded-pill px-3 <%= role==='vendor' ? 'btn-light' : 'btn-outline-light' %>">I'm a Vendor</a>
            </div>
          </div>
          <div class="col-lg-7">
            <div class="auth-panel h-100">
              <h3 class="mb-1">Create <%= role === 'vendor' ? 'Vendor' : '' %> Account</h3>
              <p class="text-muted mb-4"><%= role === 'vendor' ? 'Your account will be reviewed by our admin team before you can list products.' : 'Fill in your details to get started' %></p>
              <form method="POST" action="/auth/register">
                <input type="hidden" name="role" value="<%= role %>">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label">Full Name</label>
                    <input type="text" name="name" class="form-control" placeholder="John Doe" required>
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Phone Number</label>
                    <input type="text" name="phone" class="form-control" placeholder="03XX-XXXXXXX">
                  </div>
                  <div class="col-12">
                    <label class="form-label">Email Address</label>
                    <input type="email" name="email" class="form-control" placeholder="you@example.com" required>
                  </div>
                  <div class="col-12">
                    <label class="form-label">Address</label>
                    <input type="text" name="address" class="form-control" placeholder="Street address">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">City</label>
                    <input type="text" name="city" class="form-control" placeholder="Karachi">
                  </div>
                  <div class="col-md-6"></div>
                  <div class="col-md-6">
                    <label class="form-label">Password</label>
                    <input type="password" name="password" class="form-control" placeholder="At least 6 characters" required minlength="6">
                  </div>
                  <div class="col-md-6">
                    <label class="form-label">Confirm Password</label>
                    <input type="password" name="confirm_password" class="form-control" placeholder="Re-enter password" required minlength="6">
                  </div>
                </div>
                <div class="form-check mt-3">
                  <input class="form-check-input" type="checkbox" id="terms" required>
                  <label class="form-check-label small" for="terms">I agree to the Terms of Service and Privacy Policy</label>
                </div>
                <button type="submit" class="btn btn-podify-primary w-100 py-2 rounded-pill-lg mt-4">
                  <%= role === 'vendor' ? 'Apply as Vendor' : 'Create Account' %>
                </button>
              </form>
              <p class="text-center text-muted mt-4 mb-0">Already have an account? <a href="/auth/login" class="fw-semibold">Login</a></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/scripts') %>
</body>
</html>
