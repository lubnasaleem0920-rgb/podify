<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>
<div class="dash-shell">
  <%- include('../partials/user-sidebar') %>
  <main class="dash-main">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
      <div>
        <h3 class="mb-1">Order <%= order.order_number %></h3>
        <span class="text-muted small">Placed on <%= new Date(order.created_at).toLocaleString() %></span>
      </div>
      <span class="status-pill status-<%= order.status %> fs-6"><%= order.status.replace('_',' ') %></span>
    </div>

    <!-- Tracking Timeline -->
    <div class="pd-card p-4 mb-4">
      <h6 class="mb-4">Order Tracking</h6>
      <% const steps = ['placed','confirmed','in_production','shipped','delivered'];
         const stepLabels = { placed: 'Order Placed', confirmed: 'Confirmed', in_production: 'In Production', shipped: 'Shipped', delivered: 'Delivered' };
         const currentIdx = steps.indexOf(order.status); %>
      <div class="d-flex justify-content-between position-relative">
        <% steps.forEach((s, i) => { %>
          <div class="text-center flex-fill position-relative">
            <div class="mx-auto rounded-circle d-flex align-items-center justify-content-center"
                 style="width:40px;height:40px; background: <%= i <= currentIdx ? 'var(--pd-gradient)' : 'var(--pd-bg-elevated)' %>; border: 1px solid <%= i <= currentIdx ? 'transparent' : 'var(--pd-border)' %>; color: <%= i <= currentIdx ? '#fff' : 'var(--pd-text-muted)' %>; z-index: 2; position:relative;">
              <i class="bi bi-check-lg"></i>
            </div>
            <div class="small mt-2 <%= i <= currentIdx ? 'fw-semibold' : 'text-muted' %>" style="<%= i <= currentIdx ? 'color:var(--pd-text);' : '' %>"><%= stepLabels[s] %></div>
          </div>
        <% }) %>
        <div style="position:absolute; top:20px; left:8%; right:8%; height:3px; background:var(--pd-border); z-index:1;">
          <div style="height:100%; background:var(--pd-gradient); width:<%= (currentIdx / (steps.length-1)) * 100 %>%;"></div>
        </div>
      </div>
      <% if (order.status === 'cancelled') { %>
        <div class="alert alert-danger mt-4 mb-0">This order has been cancelled.</div>
      <% } %>
    </div>

    <div class="row g-4">
      <div class="col-lg-8">
        <div class="pd-card p-4 mb-4">
          <h6 class="mb-3">Items (<%= items.length %>)</h6>
          <% items.forEach(item => { %>
            <div class="d-flex gap-3 mb-3 pb-3 border-bottom">
              <img src="<%= item.front_preview || item.front_image %>" class="rounded-3" style="width:80px;height:80px;object-fit:cover;">
              <div class="flex-grow-1">
                <h6 class="mb-1"><%= item.product_name %></h6>
                <div class="text-muted small mb-1">
                  <% if (item.color_name) { %><span class="d-inline-block rounded-circle me-1" style="width:9px;height:9px;background:<%= item.color_hex %>;"></span><%= item.color_name %> · <% } %>
                  <%= item.material_name || 'Standard' %> · <%= item.size_label || 'Standard' %> · Qty: <%= item.quantity %>
                </div>
                <span class="status-pill status-<%= item.item_status %>"><%= item.item_status.replace('_',' ') %></span>
                <div class="fw-semibold mt-1">Rs <%= item.line_total.toFixed(2) %></div>
              </div>
              <div class="d-flex flex-column gap-2">
                <% if (item.front_preview) { %>
                  <a href="/user/orders/<%= order.id %>/design/<%= item.id %>/download" class="btn btn-sm btn-podify-outline rounded-pill"><i class="bi bi-download me-1"></i>Design</a>
                <% } %>
                <% if (order.status === 'delivered' && !reviewedIds.has(item.id)) { %>
                  <button class="btn btn-sm btn-accent rounded-pill review-btn" data-product-id="<%= item.product_id %>" data-item-id="<%= item.id %>" data-bs-toggle="modal" data-bs-target="#reviewModal">Rate</button>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>

        <div class="pd-card p-4">
          <h6 class="mb-3">Status History</h6>
          <ul class="list-unstyled mb-0">
            <% history.forEach(h => { %>
              <li class="d-flex gap-3 mb-3">
                <i class="bi bi-check-circle-fill text-success"></i>
                <div>
                  <div class="fw-semibold small text-capitalize"><%= h.status.replace('_',' ') %></div>
                  <div class="text-muted small"><%= new Date(h.created_at).toLocaleString() %><%= h.note ? ' — ' + h.note : '' %></div>
                </div>
              </li>
            <% }) %>
          </ul>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="pd-card p-4 mb-3">
          <h6 class="mb-3">Shipping Details</h6>
          <p class="mb-1 small"><strong><%= order.shipping_name %></strong></p>
          <p class="mb-1 small text-muted"><%= order.shipping_phone %></p>
          <p class="mb-1 small text-muted"><%= order.shipping_address %>, <%= order.shipping_city %></p>
        </div>
        <div class="pd-card p-4">
          <h6 class="mb-3">Payment Summary</h6>
          <div class="d-flex justify-content-between small mb-2"><span class="text-muted">Subtotal</span><span>Rs <%= order.subtotal.toFixed(2) %></span></div>
          <div class="d-flex justify-content-between small mb-2"><span class="text-muted">Shipping</span><span>Rs <%= order.shipping_fee.toFixed(2) %></span></div>
          <hr>
          <div class="d-flex justify-content-between fw-bold"><span>Total</span><span>Rs <%= order.total.toFixed(2) %></span></div>
          <div class="mt-3"><span class="status-pill status-<%= order.payment_status %>"><%= order.payment_method.toUpperCase() %> — <%= order.payment_status %></span></div>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- Review Modal -->
<div class="modal fade" id="reviewModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title">Rate this product</h5><button class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div class="mb-3 text-center fs-3" id="starRating">
          <% for(let i=1;i<=5;i++){ %><i class="bi bi-star" data-star="<%= i %>" style="cursor:pointer;color:var(--pd-warning);"></i><% } %>
        </div>
        <textarea id="reviewComment" class="form-control" rows="3" placeholder="Share your experience..."></textarea>
      </div>
      <div class="modal-footer">
        <button class="btn btn-podify-primary rounded-pill px-4" id="submitReviewBtn">Submit Review</button>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/scripts') %>
<script>
let selectedRating = 0, activeProductId = null, activeItemId = null;
document.querySelectorAll('.review-btn').forEach(btn => {
  btn.addEventListener('click', () => { activeProductId = btn.dataset.productId; activeItemId = btn.dataset.itemId; selectedRating = 0; updateStars(); });
});
document.querySelectorAll('#starRating i').forEach(star => {
  star.addEventListener('click', () => { selectedRating = parseInt(star.dataset.star); updateStars(); });
});
function updateStars() {
  document.querySelectorAll('#starRating i').forEach(s => s.className = parseInt(s.dataset.star) <= selectedRating ? 'bi bi-star-fill' : 'bi bi-star');
}
document.getElementById('submitReviewBtn').addEventListener('click', async () => {
  if (!selectedRating) { alert('Please select a rating'); return; }
  const res = await fetch('/api/reviews/add', {
    method: 'POST', headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ productId: activeProductId, orderItemId: activeItemId, rating: selectedRating, comment: document.getElementById('reviewComment').value })
  });
  const data = await res.json();
  if (data.ok) window.location.reload(); else alert(data.error || 'Could not submit review');
});
</script>
</body>
</html>
