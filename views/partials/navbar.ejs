<nav class="navbar navbar-expand-lg podify-navbar sticky-top">
  <div class="container">
    <a class="navbar-brand" href="/">
      <span class="brand-mark"><i class="bi bi-stars"></i></span>
      <span class="brand-text">Podify</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav mx-auto">
        <li class="nav-item"><a class="nav-link <%= currentPath === '/' ? 'active' : '' %>" href="/">Home</a></li>
        <li class="nav-item"><a class="nav-link <%= currentPath.startsWith('/products') ? 'active' : '' %>" href="/products">Browse Products</a></li>
        <li class="nav-item"><a class="nav-link" href="/about">About</a></li>
        <li class="nav-item"><a class="nav-link" href="/contact">Contact</a></li>
        <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'customer') { %>
        <li class="nav-item"><a class="nav-link" href="/user/orders">Track Order</a></li>
        <% } %>
      </ul>

      <div class="d-flex align-items-center gap-2 nav-actions">
        <form class="d-none d-lg-flex search-form" action="/products" method="GET">
          <input type="search" name="q" class="form-control form-control-sm" placeholder="Search products...">
          <button class="btn btn-sm" type="submit"><i class="bi bi-search"></i></button>
        </form>

        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <% if (currentUser.role === 'customer') { %>
            <a href="/user/favorites" class="icon-btn" title="Favorites"><i class="bi bi-heart"></i></a>
            <a href="/user/cart" class="icon-btn position-relative" title="Cart">
              <i class="bi bi-bag"></i>
              <% if (typeof cartCount !== 'undefined' && cartCount > 0) { %>
                <span class="badge-dot"><%= cartCount %></span>
              <% } %>
            </a>
          <% } %>
          <a href="/<%= currentUser.role === 'customer' ? 'user' : currentUser.role %>/notifications<%= currentUser.role === 'admin' ? '' : '' %>" class="icon-btn position-relative" title="Notifications">
            <i class="bi bi-bell"></i>
            <% if (typeof unreadNotifCount !== 'undefined' && unreadNotifCount > 0) { %>
              <span class="badge-dot"><%= unreadNotifCount %></span>
            <% } %>
          </a>
          <div class="dropdown">
            <a class="user-chip dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
              <img src="<%= currentUser.avatar || '/images/default-avatar.svg' %>" class="avatar-sm" alt="">
              <span class="d-none d-md-inline"><%= currentUser.name.split(' ')[0] %></span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg">
              <% if (currentUser.role === 'customer') { %>
                <li><a class="dropdown-item" href="/user/dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                <li><a class="dropdown-item" href="/user/profile"><i class="bi bi-person me-2"></i>Profile</a></li>
                <li><a class="dropdown-item" href="/user/orders"><i class="bi bi-box-seam me-2"></i>My Orders</a></li>
                <li><a class="dropdown-item" href="/user/favorites"><i class="bi bi-heart me-2"></i>Favorites</a></li>
              <% } else if (currentUser.role === 'vendor') { %>
                <li><a class="dropdown-item" href="/vendor/dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                <li><a class="dropdown-item" href="/vendor/products"><i class="bi bi-box-seam me-2"></i>My Products</a></li>
                <li><a class="dropdown-item" href="/vendor/orders"><i class="bi bi-bag-check me-2"></i>Orders</a></li>
              <% } else if (currentUser.role === 'admin') { %>
                <li><a class="dropdown-item" href="/admin/dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                <li><a class="dropdown-item" href="/admin/settings"><i class="bi bi-gear me-2"></i>Settings</a></li>
              <% } %>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item text-danger" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
            </ul>
          </div>
        <% } else { %>
          <a href="/auth/login" class="btn btn-podify-outline btn-sm rounded-pill px-3">Login</a>
          <a href="/auth/register" class="btn btn-podify-primary btn-sm rounded-pill px-3">Get Started</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
