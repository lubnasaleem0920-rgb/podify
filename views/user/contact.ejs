<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<div class="bg-pd-soft py-4">
  <div class="container">
    <h3 class="mb-0">Contact Us</h3>
    <p class="text-muted mb-0">We'd love to hear from you</p>
  </div>
</div>

<div class="container section-pad">
  <div class="row g-5">
    <div class="col-lg-5">
      <h5 class="mb-4">Get in Touch</h5>
      <div class="d-flex gap-3 mb-4">
        <div class="stat-card" style="width:46px;height:46px;padding:0;display:flex;align-items:center;justify-content:center;background:var(--pd-gradient-soft);"><i class="bi bi-envelope text-primary"></i></div>
        <div><div class="fw-semibold">Email</div><div class="text-muted small">support@podify.com</div></div>
      </div>
      <div class="d-flex gap-3 mb-4">
        <div class="stat-card" style="width:46px;height:46px;padding:0;display:flex;align-items:center;justify-content:center;background:var(--pd-gradient-soft);"><i class="bi bi-telephone text-primary"></i></div>
        <div><div class="fw-semibold">Phone</div><div class="text-muted small">+92 300 1234567</div></div>
      </div>
      <div class="d-flex gap-3 mb-4">
        <div class="stat-card" style="width:46px;height:46px;padding:0;display:flex;align-items:center;justify-content:center;background:var(--pd-gradient-soft);"><i class="bi bi-geo-alt text-primary"></i></div>
        <div><div class="fw-semibold">Office</div><div class="text-muted small">Karachi, Pakistan</div></div>
      </div>
    </div>
    <div class="col-lg-7">
      <div class="pd-form-card">
        <form method="POST" action="/contact">
          <div class="row g-3">
            <div class="col-md-6"><label class="form-label">Name</label><input type="text" class="form-control" required></div>
            <div class="col-md-6"><label class="form-label">Email</label><input type="email" class="form-control" required></div>
            <div class="col-12"><label class="form-label">Subject</label><input type="text" class="form-control" required></div>
            <div class="col-12"><label class="form-label">Message</label><textarea class="form-control" rows="5" required></textarea></div>
          </div>
          <button type="submit" class="btn btn-podify-primary rounded-pill px-4 mt-4">Send Message</button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
</body>
</html>
