<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>
<div class="dash-shell">
  <%- include('../partials/admin-sidebar') %>
  <main class="dash-main">
    <h3 class="mb-4">System Settings</h3>
    <div class="pd-card p-4" style="max-width:640px;">
      <form method="POST" action="/admin/settings">
        <div class="mb-3">
          <label class="form-label">Site Name</label>
          <input type="text" name="site_name" class="form-control" value="<%= settings.site_name || 'Podify' %>">
        </div>
        <div class="mb-3">
          <label class="form-label">Support Email</label>
          <input type="email" name="support_email" class="form-control" value="<%= settings.support_email || 'support@podify.com' %>">
        </div>
        <div class="mb-3">
          <label class="form-label">Free Shipping Threshold (Rs)</label>
          <input type="number" name="free_shipping_threshold" class="form-control" value="<%= settings.free_shipping_threshold || 3000 %>">
        </div>
        <div class="mb-3">
          <label class="form-label">Standard Shipping Fee (Rs)</label>
          <input type="number" name="shipping_fee" class="form-control" value="<%= settings.shipping_fee || 150 %>">
        </div>
        <div class="form-check form-switch mb-3">
          <input class="form-check-input" type="checkbox" name="maintenance_mode" value="1" id="maint" <%= settings.maintenance_mode === '1' ? 'checked' : '' %>>
          <label class="form-check-label" for="maint">Maintenance Mode</label>
        </div>
        <button type="submit" class="btn btn-podify-primary rounded-pill px-4">Save Settings</button>
      </form>
    </div>
  </main>
</div>
<%- include('../partials/scripts') %>
</body>
</html>
