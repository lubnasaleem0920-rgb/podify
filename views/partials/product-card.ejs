<div class="pd-card product-card">
  <a href="/products/<%= p.slug %>" class="img-wrap d-block">
    <img src="<%= p.front_image %>" alt="<%= p.name %>" loading="lazy">
    <button type="button" class="fav-btn" data-product-id="<%= p.id %>"><i class="bi bi-heart"></i></button>
  </a>
  <div class="body">
    <div class="cat-badge"><%= p.category_name || 'Podify' %></div>
    <a href="/products/<%= p.slug %>" class="text-decoration-none">
      <h6 class="mb-1 text-truncate" style="color:var(--pd-text);"><%= p.name %></h6>
    </a>
    <div class="rating mb-2">
      <% for (let i=1;i<=5;i++) { %><i class="bi <%= i <= Math.round(p.rating_avg) ? 'bi-star-fill' : 'bi-star' %>"></i><% } %>
      <span class="text-muted small">(<%= p.rating_count %>)</span>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-auto">
      <span class="price-tag">Rs <%= p.base_price.toFixed(0) %>+</span>
      <a href="/products/<%= p.slug %>" class="btn btn-podify-primary btn-sm rounded-pill px-3">Customize</a>
    </div>
  </div>
</div>
