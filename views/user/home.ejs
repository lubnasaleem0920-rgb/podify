<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>

<!-- HERO -->
<section class="hero-section">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <span class="hero-badge"><i class="bi bi-lightning-charge-fill"></i> Elimination-based smart pricing</span>
        <h1 class="font-display">Design It Yourself. <br>We'll <span class="text-gradient">Print</span> The Rest.</h1>
        <p class="lead mt-3">Upload your image, add custom text or calligraphy, preview it live on your favorite product, and get an instant price — before you even order.</p>
        <div class="d-flex gap-3 mt-4 flex-wrap">
          <a href="/products" class="btn btn-podify-primary btn-lg rounded-pill-lg px-4 fw-semibold">Start Designing <i class="bi bi-arrow-right ms-1"></i></a>
          <a href="/auth/register?role=vendor" class="btn btn-podify-outline btn-lg rounded-pill-lg px-4">Become a Vendor</a>
        </div>
        <div class="d-flex gap-4 mt-5 flex-wrap">
          <div><h3 class="mb-0" style="color:var(--pd-text);">10K+</h3><small style="color:var(--pd-text-soft);">Happy Customers</small></div>
          <div><h3 class="mb-0" style="color:var(--pd-text);">500+</h3><small style="color:var(--pd-text-soft);">Products</small></div>
          <div><h3 class="mb-0" style="color:var(--pd-text);">50+</h3><small style="color:var(--pd-text-soft);">Vendors</small></div>
        </div>
      </div>
      <div class="col-lg-6 d-none d-lg-block">
        <div class="hero-visual position-relative">
          <img src="/images/products/water-bottle.svg" style="width:78%; margin-left:11%; border-radius:24px; box-shadow: 0 30px 60px rgba(0,0,0,0.25);" alt="Custom water bottle preview">
          <div class="hero-float-card" style="top:10%; left:-4%;"><i class="bi bi-palette-fill text-primary"></i> Live Preview</div>
          <div class="hero-float-card" style="bottom:8%; right:-4%;"><i class="bi bi-cash-coin text-success"></i> Rs 850.00</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CATEGORIES -->
<section class="section-pad">
  <div class="container">
    <div class="text-center mb-5">
      <span class="section-eyebrow">What can you customize?</span>
      <h2 class="section-title">Browse by Category</h2>
    </div>
    <div class="row g-3">
      <% categories.forEach(cat => { %>
        <div class="col-6 col-md-3">
          <a href="/products?category=<%= cat.slug %>" class="category-pill">
            <i class="bi <%= cat.icon || 'bi-box' %>"></i>
            <div class="mt-2 fw-semibold small"><%= cat.name %></div>
          </a>
        </div>
      <% }) %>
      <% if (categories.length === 0) { %>
        <div class="col-12 text-center text-muted">Categories will appear here once added by admin.</div>
      <% } %>
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="section-pad bg-pd-soft">
  <div class="container">
    <div class="text-center mb-5">
      <span class="section-eyebrow">Simple Process</span>
      <h2 class="section-title">How Podify Works</h2>
    </div>
    <div class="row g-4">
      <div class="col-md-3 col-6">
        <div class="step-card"><div class="step-num">1</div><h6>Pick a Product</h6><p class="small">Browse bottles, mugs, apparel & more.</p></div>
      </div>
      <div class="col-md-3 col-6">
        <div class="step-card"><div class="step-num">2</div><h6>Customize Live</h6><p class="small">Add your image or text, see it instantly.</p></div>
      </div>
      <div class="col-md-3 col-6">
        <div class="step-card"><div class="step-num">3</div><h6>Get Instant Price</h6><p class="small">Price auto-calculates by size & material.</p></div>
      </div>
      <div class="col-md-3 col-6">
        <div class="step-card"><div class="step-num">4</div><h6>Order & Track</h6><p class="small">Checkout securely and track delivery.</p></div>
      </div>
    </div>
  </div>
</section>

<!-- FEATURED PRODUCTS -->
<section class="section-pad">
  <div class="container">
    <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-2">
      <div><span class="section-eyebrow">Top Picks</span><h2 class="section-title mb-0">Featured Products</h2></div>
      <a href="/products" class="btn btn-podify-outline rounded-pill px-4">View All <i class="bi bi-arrow-right"></i></a>
    </div>
    <div class="row g-4">
      <% featured.forEach(p => { %>
        <div class="col-lg-3 col-md-4 col-6">
          <%- include('../partials/product-card', { p }) %>
        </div>
      <% }) %>
      <% if (featured.length === 0) { %>
        <div class="col-12 empty-state"><i class="bi bi-box-seam"></i><h5>No products yet</h5><p class="text-muted">Vendors haven't added products yet. Check back soon!</p></div>
      <% } %>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="section-pad">
  <div class="container">
    <div class="p-5 rounded-4 text-center" style="background: var(--pd-gradient);">
      <h2 class="text-white mb-2">Have a great print idea?</h2>
      <p class="text-white-50 mb-4">List your products on Podify and reach thousands of customers looking for custom prints.</p>
      <a href="/auth/register?role=vendor" class="btn btn-light rounded-pill-lg px-4 fw-semibold">Become a Vendor Today</a>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
</body>
</html>
