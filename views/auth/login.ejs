<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %></head>
<body>
<%- include('../partials/flash') %>
<div class="auth-wrapper">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-9">
        <div class="row g-0 shadow-lg rounded-4 overflow-hidden">
          <div class="col-lg-5 auth-side d-none d-lg-flex">
            <a href="/" class="brand-text mb-4" style="font-size:1.6rem;"><i class="bi bi-stars me-1"></i>Podify</a>
            <h3 class="text-white mb-3">Welcome back, creator!</h3>
            <p class="text-white-50">Login to continue customizing your favorite products, track your orders, and manage your designs.</p>
            <ul class="list-unstyled text-white-50 mt-4">
              <li class="mb-2"><i class="bi bi-check-circle me-2"></i>Live product customization</li>
              <li class="mb-2"><i class="bi bi-check-circle me-2"></i>Instant price calculation</li>
              <li class="mb-2"><i class="bi bi-check-circle me-2"></i>Real-time order tracking</li>
            </ul>
          </div>
          <div class="col-lg-7">
            <div class="auth-panel h-100">
              <h3 class="mb-1">Login to Podify</h3>
              <p class="text-muted mb-4">Enter your credentials to access your account</p>
              <form method="POST" action="/auth/login">
                <div class="mb-3">
                  <label class="form-label">Email Address</label>
                  <input type="email" name="email" class="form-control" placeholder="you@example.com" required>
                </div>
                <div class="mb-3">
                  <label class="form-label">Password</label>
                  <input type="password" name="password" class="form-control" placeholder="••••••••" required>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-4">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="remember">
                    <label class="form-check-label small" for="remember">Remember me</label>
                  </div>
                  <a href="/auth/forgot-password" class="small">Forgot password?</a>
                </div>
                <button type="submit" class="btn btn-podify-primary w-100 py-2 rounded-pill-lg">Login</button>
              </form>
              <p class="text-center text-muted mt-4 mb-0">Don't have an account? <a href="/auth/register" class="fw-semibold">Sign up</a></p>
              <p class="text-center text-muted mt-1"><a href="/auth/register?role=vendor" class="fw-semibold small">Become a Vendor →</a></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/scripts') %>
</body>
</html>
