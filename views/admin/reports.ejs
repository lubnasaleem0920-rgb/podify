<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <script src="/vendor/chartjs/chart.umd.min.js"></script>
</head>
<body>
<%- include('../partials/navbar') %>
<%- include('../partials/flash') %>
<div class="dash-shell">
  <%- include('../partials/admin-sidebar') %>
  <main class="dash-main">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h3 class="mb-0">Reports & Analytics</h3>
      <button class="btn btn-podify-outline rounded-pill px-4" id="printReportBtn"><i class="bi bi-download me-1"></i>Export / Print</button>
    </div>

    <div class="row g-4 mb-4">
      <div class="col-lg-6">
        <div class="pd-card p-4"><h6 class="mb-3">Monthly Revenue</h6><canvas id="revChart" height="140"></canvas></div>
      </div>
      <div class="col-lg-6">
        <div class="pd-card p-4"><h6 class="mb-3">Order Status Breakdown</h6><canvas id="statusChart" height="140"></canvas></div>
      </div>
    </div>

    <div class="row g-4">
      <div class="col-lg-6">
        <div class="pd-card p-4">
          <h6 class="mb-3">Top Vendors</h6>
          <table class="table pd-table mb-0">
            <thead><tr><th>Vendor</th><th>Items Sold</th><th>Revenue</th></tr></thead>
            <tbody>
              <% topVendors.forEach(v => { %><tr><td class="small fw-semibold"><%= v.name %></td><td><%= v.items_sold %></td><td>Rs <%= v.revenue.toFixed(2) %></td></tr><% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="pd-card p-4">
          <h6 class="mb-3">Top Categories</h6>
          <table class="table pd-table mb-0">
            <thead><tr><th>Category</th><th>Items Sold</th></tr></thead>
            <tbody>
              <% topCategories.forEach(c => { %><tr><td class="small fw-semibold"><%= c.name || 'Uncategorized' %></td><td><%= c.items_sold %></td></tr><% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </main>
</div>
<%- include('../partials/scripts') %>
<script>
Chart.defaults.color = '#A9A3C2';
Chart.defaults.borderColor = 'rgba(31,27,22,0.12)';
document.getElementById('printReportBtn')?.addEventListener('click', () => window.print());
new Chart(document.getElementById('revChart'), {
  type: 'bar',
  data: { labels: <%- JSON.stringify(revenueByMonth.map(r=>r.month)) %>, datasets: [{ label:'Revenue', data: <%- JSON.stringify(revenueByMonth.map(r=>r.total)) %>, backgroundColor:'#2A2420' }] },
  options: { plugins: { legend: { display:false } } }
});
new Chart(document.getElementById('statusChart'), {
  type: 'doughnut',
  data: { labels: <%- JSON.stringify(orderStatusBreakdown.map(s=>s.status)) %>, datasets: [{ data: <%- JSON.stringify(orderStatusBreakdown.map(s=>s.c)) %>, backgroundColor:['#1F1B16','#4A4235','#6B6355','#059669','#D97706','#DC2626'], borderColor: '#FFFFFF', borderWidth: 2 }] }
});
</script>
</body>
</html>
